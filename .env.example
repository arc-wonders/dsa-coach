# --- LeetCode ---
LEETCODE_USERNAME=arkinkansra
# Only needed for the one-time full history import (python -m coach import).
# Browser -> leetcode.com (logged in) -> DevTools -> Application -> Cookies -> leetcode.com
LEETCODE_SESSION=
LEETCODE_CSRFTOKEN=

# --- Gmail (SMTP with an App Password) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Defaults to GMAIL_ADDRESS
MAIL_TO=

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- App ---
# Public URL where the app runs; the email buttons link here.
BASE_URL=http://localhost:8000
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Set this if the app is reachable from the internet
APP_PASSWORD=
TIMEZONE=Asia/Kolkata
DAILY_SEND_TIME=07:00
ENABLE_SCHEDULER=true
